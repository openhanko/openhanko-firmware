.DS_Store
__pycache__/
*.pyc

# key material: never commit. The device generates its own PIV identity and no
# private key leaves it, but the secure-boot signing PEMs live on this machine.
*.pem
keys/
out/

# build output. Matches any tree, not just */build/ — build-rp2350/ and
# build-bench/ slipped past the narrower pattern and landed 1400 files in a
# commit.
build/
build-*/
*/build/
*/build-*/
*/managed_components/
*/sdkconfig
*/sdkconfig.old
.cache/

# leftover bench build tree from the removed BUTTON_AUTHENTICATES flag
build-bench/

# Vendor documentation: kept locally, never redistributed.
*.pdf
vendor/
