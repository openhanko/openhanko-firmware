; WS2812 bit-banging, from the pico-examples program of the same name.
;
; An addressable LED needs precise sub-microsecond pulse widths, which is what
; PIO is for — doing it on the CPU would mean disabling interrupts and fighting
; USB for timing.

.program ws2812
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
do_one:
    jmp  bitloop   side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap
